engine-strict=true
save-exact=true
fund=false
audit-level=high
# No dependency install scripts, locally or in CI (plan §6.1); a package that
# needs one gets a named `npm rebuild <pkg>` step instead.
ignore-scripts=true
# The @unset scope on npmjs.org belongs to a third party: it must never resolve
# remotely, so a missing workspace fails closed with a connection error (P0-A5).
@unset:registry=https://127.0.0.1:9/
