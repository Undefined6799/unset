{
  "pluginRule": {
    "schemaPrefix": "plugin_",
    "rule": "one schema plugin_<id> and one role plugin_<id> per plugin; the role's search_path is its schema; it holds no privilege outside its schema but CONNECT; no other service or job role holds one on that schema (decision 25)"
  },
  "roles": {
    "web": {
      "database": ["CONNECT"],
      "memberOf": []
    },
    "api": {
      "database": ["CONNECT"],
      "memberOf": []
    },
    "indexer": {
      "database": ["CONNECT"],
      "memberOf": []
    },
    "admin": {
      "database": ["CONNECT"],
      "memberOf": []
    },
    "retention": {
      "database": ["CONNECT"],
      "memberOf": []
    },
    "media": {
      "database": ["CONNECT"],
      "memberOf": []
    },
    "review": {
      "database": ["CONNECT"],
      "memberOf": []
    },
    "review_egress": {
      "database": ["CONNECT"],
      "memberOf": []
    },
    "auditor": {
      "database": ["CONNECT"],
      "memberOf": []
    },
    "backup": {
      "database": ["CONNECT"],
      "memberOf": []
    },
    "legal_hold_reader": {
      "database": [],
      "memberOf": []
    },
    "audit_owner": {
      "database": [],
      "memberOf": []
    }
  },
  "schemas": {
    "*": {
      "defaults": {
        "migrator": {
          "routines": {
            "migrator": ["EXECUTE"]
          }
        },
        "audit_owner": {
          "routines": {
            "audit_owner": ["EXECUTE"]
          }
        }
      }
    },
    "app": {
      "owner": "migrator",
      "grants": {
        "admin": ["USAGE"],
        "retention": ["USAGE"],
        "web": ["USAGE"]
      },
      "defaults": {
        "migrator": {
          "sequences": {
            "web": ["SELECT", "USAGE"]
          }
        }
      }
    },
    "audit": {
      "owner": "audit_owner",
      "grants": {
        "admin": ["USAGE"],
        "auditor": ["USAGE"],
        "indexer": ["USAGE"],
        "retention": ["USAGE"],
        "web": ["USAGE"]
      }
    },
    "idx": {
      "owner": "migrator",
      "grants": {
        "admin": ["USAGE"],
        "api": ["USAGE"],
        "indexer": ["USAGE"],
        "web": ["USAGE"]
      }
    },
    "types": {
      "owner": "migrator",
      "grants": {
        "admin": ["USAGE"],
        "api": ["USAGE"],
        "audit_owner": ["USAGE"],
        "indexer": ["USAGE"],
        "web": ["USAGE"]
      }
    }
  },
  "tables": {
    "audit.append": {
      "admin": ["EXECUTE"],
      "indexer": ["EXECUTE"],
      "web": ["EXECUTE"]
    },
    "audit.chain": {
      "auditor": { "privileges": ["SELECT"], "wholeTable": true }
    },
    "app.single_use": {
      "retention": {
        "columns": {
          "expires_at": ["SELECT"]
        },
        "rowPrivileges": ["DELETE"]
      },
      "web": {
        "columns": {
          "id": ["SELECT", "INSERT"],
          "purpose": ["SELECT", "INSERT"],
          "bind_did": ["SELECT", "INSERT"],
          "bind_extra": ["SELECT", "INSERT"],
          "expires_at": ["SELECT", "INSERT"],
          "consumed_at": ["SELECT", "INSERT", "UPDATE"]
        }
      }
    },
    "app.session": {
      "web": {
        "columns": {
          "id_hash": ["SELECT", "INSERT"],
          "did": ["SELECT", "INSERT"],
          "created_at": ["SELECT", "INSERT"],
          "last_seen_at": ["SELECT", "INSERT", "UPDATE"],
          "absolute_expires_at": ["SELECT", "INSERT"],
          "email_confirmed": ["SELECT", "UPDATE"],
          "email_checked_at": ["SELECT", "UPDATE"]
        },
        "rowPrivileges": ["DELETE"]
      }
    },
    "app.end_sessions_for_did": {
      "web": ["EXECUTE"]
    },
    "app.oauth_state": {
      "web": {
        "columns": {
          "key": ["SELECT", "INSERT"],
          "sealed": ["SELECT", "INSERT", "UPDATE"],
          "expires_at": ["SELECT", "INSERT", "UPDATE"]
        },
        "rowPrivileges": ["DELETE"]
      }
    },
    "app.account": {
      "web": {
        "columns": {
          "did": ["SELECT", "INSERT"],
          "first_seen_at": ["SELECT", "INSERT"],
          "onboarding": ["SELECT", "INSERT", "UPDATE"],
          "terms_version": ["SELECT", "INSERT", "UPDATE"],
          "terms_accepted_at": ["SELECT", "INSERT", "UPDATE"],
          "privacy_version": ["SELECT", "INSERT", "UPDATE"],
          "age_confirmed_at": ["SELECT", "INSERT", "UPDATE"],
          "storage_quota_bytes": ["SELECT"]
        }
      }
    },
    "app.oauth_session": {
      "web": {
        "columns": {
          "did": ["SELECT", "INSERT"],
          "sealed": ["SELECT", "INSERT", "UPDATE"],
          "client_kid": ["SELECT", "INSERT", "UPDATE"],
          "updated_at": ["SELECT", "INSERT", "UPDATE"]
        },
        "rowPrivileges": ["DELETE"]
      }
    }
  }
}
