{
  "minTokens": 40,
  "format": ["typescript", "tsx"],
  "ignore": [
    "**/node_modules/**",
    "**/.git/**",
    "**/dist/**",
    "**/coverage/**",
    "**/.worktrees/**",
    "**/graphify-out/**",
    "**/scripts/guards/fixtures/**",
    "**/scripts/lint/semgrep/fixtures/**"
