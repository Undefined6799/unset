{
  "name": "unset.sh",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=26.0.0"
  },
  "workspaces": [
    "apps/*",
    "interfaces/*",
    "domains/*",
    "infrastructure/*",
    "shared/*"
  ],
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm run guards && npm test",
    "typecheck": "tsc -b",
    "lint": "biome ci . && depcruise --config .dependency-cruiser.cjs .",
    "format": "biome format --write .",
    "guards": "vitest run scripts/guards",
    "test": "node scripts/test/run.ts",
    "budgets": "node scripts/budgets/check.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@swc/core": "1.16.13",
    "@types/node": "26.6.3",
    "dependency-cruiser": "18.5.0",
    "fast-check": "4.10.2",
    "jscpd": "5.3.2",
    "jsdom": "30.1.1",
    "parse5": "8.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
