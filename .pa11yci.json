{
  "defaults": {
    "standard": "WCAG2AA",
    "timeout": 60000,
    "wait": 1000,
    "runners": ["axe", "htmlcs"],
    "levelCapWhenNeedsReview": "warning",
    "ignore": [
      "WCAG2AA.Principle4.Guideline4_1.4_1_2.H91.A.NoContent",
      "WCAG2AA.Principle1.Guideline1_4.1_4_3.G18.Fail"
    ],
    "chromeLaunchConfig": {
      "args": [
        "--no-sandbox",
        "--disable-dev-shm-usage",
        "--host-resolver-rules=MAP unset.test 127.0.0.1",
        "--ignore-certificate-errors"
      ]
    }
  },
  "urls": [
    "https://unset.test:8443/",
    "https://unset.test:8443/legal/terms",
    "https://unset.test:8443/legal/privacy",
    "https://unset.test:8443/legal/domains",
    "https://unset.test:8443/login",
    "https://unset.test:8443/signed-out",
    "https://unset.test:8443/welcome/blocked"
  ]
}
