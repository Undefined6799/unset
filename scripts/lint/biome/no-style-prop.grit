// No JSX `style` prop (P1.23r; plan §5.1, step book P1.23 "Lint"). Loaded by biome.json for every .tsx and .jsx file in
// apps/, interfaces/ and shared/. The app CSP's style-src has no 'unsafe-inline', so a server-rendered style=""
// attribute is blocked in the browser (P1.20 measured it); this rule catches it before the browser does.
//
// GritQL as Biome 2.5.15 runs it (biomejs.dev/linter/plugins, read 2026-10-06; behaviour checked against the pinned
// binary): JsxAttribute's name is the attribute name node, and r"…" matches its whole text, so data-style and
// styleName pass. A spread ({...props}) is not inspected.
language js

JsxAttribute(name=$name) as $attr where {
  $name <: r"style",
  register_diagnostic(span=$attr, message="no style prop: style with a CSS Module class and tokens; the CSP blocks inline styles")
}
