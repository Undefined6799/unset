#!/bin/sh
# Enable once per clone: git config core.hooksPath scripts/githooks
# Mirrors CI so secrets never reach a commit. CI still runs gitleaks on every PR,
# because hooks are opt-in.
set -eu
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact --no-banner --config .github/.gitleaks.toml
else
  echo "pre-commit: gitleaks not installed; secret scan skipped locally (CI still runs it)." >&2
fi
# Git exports GIT_DIR, GIT_INDEX_FILE and GIT_WORK_TREE to hooks (githooks(5)); the guards find the repository by
# their working directory, as in CI, and their throwaway repositories must not inherit these (P0.09j).
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE
npm run --silent guards
