{
  "lexicon": 1,
  "id": "sh.unset.section",
  "description": "One card on an unset.sh profile page. The profile record's cards list sets the order (ADR 0051).",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "A profile card: its width and its content.",
      "record": {
        "type": "object",
        "required": ["content", "createdAt"],
        "properties": {
          "content": {
            "type": "union",
            "refs": ["#readme", "#links", "#collection", "#buttons", "#image", "#gallery"],
            "description": "What the card holds. A kind a reader does not know hides the card; it is never an error."
          },
          "width": {
            "type": "string",
            "maxLength": 32,
            "knownValues": ["full", "half"],
            "description": "Width on wide screens. Absent or unknown means full."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime",
            "description": "When the card was first published."
          },
          "surface": {
            "type": "string",
            "maxLength": 32,
            "knownValues": ["filled", "outlined", "plain"],
            "description": "Outer card surface. Absent or unknown means filled."
          }
        }
      }
    },
    "readme": {
      "type": "object",
      "required": ["text"],
      "description": "Text the member writes, shown like a README.",
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 100000,
          "description": "Markdown (CommonMark). Readers never render raw HTML and keep only http and https links."
        }
      }
    },
    "links": {
      "type": "object",
      "required": ["items"],
      "description": "Addresses elsewhere. Readers derive each one's icon and account name from its URL; nothing about the site is stored.",
      "properties": {
        "title": {
          "type": "string",
          "maxGraphemes": 100,
          "maxLength": 1000
        },
        "layout": {
          "type": "string",
          "maxLength": 32,
          "knownValues": ["list", "carousel", "grid"],
          "description": "Absent or unknown means list."
        },
        "items": {
          "type": "array",
          "maxLength": 100,
          "items": {
            "type": "ref",
            "ref": "#link"
          },
          "description": "In display order."
        }
      }
    },
    "link": {
      "type": "object",
      "required": ["uri"],
      "description": "One address.",
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri",
          "maxLength": 2000,
          "description": "An http or https URL. A reader drops any other scheme."
        },
        "label": {
          "type": "string",
          "maxGraphemes": 100,
          "maxLength": 1000,
          "description": "Text shown when the URL names no account."
        },
        "description": {
          "type": "string",
          "maxGraphemes": 200,
          "maxLength": 2000
        }
      }
    },
    "collection": {
      "type": "object",
      "required": ["items"],
      "description": "Titled entries, such as projects, writing or talks.",
      "properties": {
        "title": {
          "type": "string",
          "maxGraphemes": 100,
          "maxLength": 1000
        },
        "layout": {
          "type": "string",
          "maxLength": 32,
          "knownValues": ["list", "carousel", "grid"],
          "description": "Absent or unknown means carousel."
        },
        "items": {
          "type": "array",
          "maxLength": 100,
          "items": {
            "type": "ref",
            "ref": "#entry"
          },
          "description": "In display order."
        }
      }
    },
    "entry": {
      "type": "object",
      "required": ["title"],
      "description": "One entry in a collection.",
      "properties": {
        "title": {
          "type": "string",
          "maxGraphemes": 120,
          "maxLength": 1200
        },
        "tag": {
          "type": "string",
          "maxGraphemes": 40,
          "maxLength": 400,
          "description": "Small label above the title."
        },
        "description": {
          "type": "string",
          "maxGraphemes": 300,
          "maxLength": 3000
        },
        "uri": {
          "type": "string",
          "format": "uri",
          "maxLength": 2000,
          "description": "An http or https URL. A reader drops any other scheme."
        },
        "image": {
          "type": "ref",
          "ref": "sh.unset.defs#image",
          "description": "A picture shown with the entry, in its own proportions."
        }
      }
    },
    "buttons": {
      "type": "object",
      "required": ["heading", "buttons"],
      "description": "A short pitch with buttons; the first is the main one.",
      "properties": {
        "heading": {
          "type": "string",
          "maxGraphemes": 120,
          "maxLength": 1200
        },
        "text": {
          "type": "string",
          "maxGraphemes": 400,
          "maxLength": 4000
        },
        "buttons": {
          "type": "array",
          "maxLength": 5,
          "items": {
            "type": "union",
            "refs": ["#emailButton", "#linkButton"]
          },
          "description": "In display order. A kind a reader does not know is skipped."
        }
      }
    },
    "emailButton": {
      "type": "object",
      "required": ["address"],
      "description": "Opens an email to the address, which the member chose to publish.",
      "properties": {
        "address": {
          "type": "string",
          "maxLength": 254
        }
      }
    },
    "linkButton": {
      "type": "object",
      "required": ["preset", "uri"],
      "description": "Opens a link. Readers word the button from the preset.",
      "properties": {
        "preset": {
          "type": "string",
          "maxLength": 32,
          "knownValues": ["bookCall", "hire", "subscribe", "custom"],
          "description": "Absent from the known values means custom."
        },
        "uri": {
          "type": "string",
          "format": "uri",
          "maxLength": 2000,
          "description": "An http or https URL. A reader drops any other scheme."
        },
        "label": {
          "type": "string",
          "maxGraphemes": 40,
          "maxLength": 400,
          "description": "Button text for custom."
        }
      }
    },
    "image": {
      "type": "object",
      "required": ["image"],
      "description": "One picture with its caption and fit. Also each picture of a gallery.",
      "properties": {
        "image": {
          "type": "ref",
          "ref": "sh.unset.defs#image"
        },
        "caption": {
          "type": "string",
          "maxGraphemes": 300,
          "maxLength": 3000,
          "description": "Text shown under the picture."
        },
        "fit": {
          "type": "string",
          "maxLength": 32,
          "knownValues": ["contain", "fill"],
          "description": "contain shows the whole picture in its own proportions; fill crops it to fill the space. Absent or unknown means contain."
        }
      }
    },
    "gallery": {
      "type": "object",
      "required": ["images"],
      "description": "A small set of pictures.",
      "properties": {
        "title": {
          "type": "string",
          "maxGraphemes": 100,
          "maxLength": 1000
        },
        "images": {
          "type": "array",
          "maxLength": 12,
          "items": {
            "type": "ref",
            "ref": "#image"
          },
          "description": "In display order. A gallery holds at least one picture; the editor deletes a card left empty.",
          "minLength": 1
        }
      }
    }
  }
}
