{
  "lexicon": 1,
  "id": "sh.unset.follow",
  "description": "A public follow of another unset.sh account. Following a Bluesky account uses app.bsky.graph.follow instead.",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "The account follows the subject. Same shape as app.bsky.graph.follow.",
      "record": {
        "type": "object",
        "required": ["subject", "createdAt"],
        "properties": {
          "subject": {
            "type": "string",
            "format": "did",
            "description": "DID of the followed account."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime",
            "description": "When the follow was made."
          }
        }
      }
    }
  }
}
