{
  "lexicon": 1,
  "id": "sh.unset.profile",
  "description": "An unset.sh profile: the public page at unset.sh/@handle. One per account.",
  "defs": {
    "main": {
      "type": "record",
      "key": "literal:self",
      "description": "The account's unset.sh profile. Absent means the account has no published unset.sh profile.",
      "record": {
        "type": "object",
        "required": ["displayName", "createdAt"],
        "properties": {
          "displayName": {
            "type": "string",
            "maxGraphemes": 64,
            "maxLength": 640,
            "description": "Name shown at the top of the profile."
          },
          "headline": {
            "type": "string",
            "maxGraphemes": 120,
            "maxLength": 1200,
            "description": "One line under the name."
          },
          "bio": {
            "type": "string",
            "maxGraphemes": 600,
            "maxLength": 6000,
            "description": "About text: paragraphs, bold, italic and http(s) links (a small markdown subset), never HTML."
          },
          "readme": {
            "type": "ref",
            "ref": "#readme"
          },
          "location": {
            "type": "string",
            "maxGraphemes": 100,
            "maxLength": 1000,
            "description": "Free-text place, as the member writes it."
          },
          "website": {
            "type": "string",
            "format": "uri",
            "maxLength": 2000,
            "description": "The member's website: an http or https URL."
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "description": "Contact address the member chose to show. Present only when they switched show-email on."
          },
          "avatar": {
            "type": "blob",
            "accept": ["image/png", "image/jpeg", "image/webp"],
            "maxSize": 1000000,
            "description": "Square profile picture."
          },
          "coverImage": {
            "type": "blob",
            "accept": ["image/png", "image/jpeg", "image/webp"],
            "maxSize": 2000000,
            "description": "Wide header image (3:1)."
          },
          "links": {
            "type": "array",
            "maxLength": 12,
            "items": {
              "type": "ref",
              "ref": "#link"
            },
            "description": "The member's links elsewhere (other sites and accounts), in display order."
          },
          "availability": {
            "type": "ref",
            "ref": "#availability"
          },
          "stats": {
            "type": "array",
            "maxLength": 12,
            "items": {
              "type": "ref",
              "ref": "#stat"
            },
            "description": "Short label and value pairs, in display order."
          },
          "cta": {
            "type": "ref",
            "ref": "#cta"
          },
          "listed": {
            "type": "boolean",
            "description": "True: listed in the unset.sh directory. Absent or false: not listed; the page is still public at its URL."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime",
            "description": "When the profile was first published."
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime",
            "description": "When the profile was last published."
          }
        }
      }
    },
    "readme": {
      "type": "object",
      "required": ["blocks"],
      "description": "Free-form page body as typed blocks (the owner edits it with a block editor), never HTML. At most 100000 bytes as JSON; a reader refuses a larger README, since a schema cannot state a total.",
      "properties": {
        "blocks": {
          "type": "array",
          "maxLength": 200,
          "items": {
            "type": "union",
            "refs": ["#display", "#paragraph", "#heading", "#listItem", "#quote", "#codeBlock", "#columns"]
          },
          "description": "Blocks in reading order. A block type this app does not know is skipped."
        }
      }
    },
    "textRun": {
      "type": "object",
      "required": ["text"],
      "description": "A run of text with one set of styles.",
      "properties": {
        "text": {
          "type": "string",
          "maxGraphemes": 2000,
          "maxLength": 20000
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "underline": {
          "type": "boolean"
        },
        "strike": {
          "type": "boolean"
        },
        "code": {
          "type": "boolean",
          "description": "Inline code."
        }
      }
    },
    "linkRun": {
      "type": "object",
      "required": ["uri", "content"],
      "description": "Linked text.",
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri",
          "maxLength": 2000,
          "description": "An http or https URL. A schema cannot state the scheme; a reader keeps the text and drops the link for any other."
        },
        "content": {
          "type": "array",
          "maxLength": 50,
          "items": {
            "type": "ref",
            "ref": "#textRun"
          }
        }
      }
    },
    "paragraph": {
      "type": "object",
      "required": ["content"],
      "description": "A paragraph.",
      "properties": {
        "align": {
          "type": "string",
          "maxLength": 16,
          "knownValues": ["center", "right"],
          "description": "Text alignment. Absent, or an unknown value, reads as the start of the line."
        },
        "content": {
          "type": "array",
          "maxLength": 200,
          "items": {
            "type": "union",
            "refs": ["#textRun", "#linkRun"]
          },
          "description": "The block's text, as runs in reading order."
        }
      }
    },
    "display": {
      "type": "object",
      "required": ["content"],
      "description": "Display text: the design sheet's largest type style, for a hero line.",
      "properties": {
        "align": {
          "type": "string",
          "maxLength": 16,
          "knownValues": ["center", "right"],
          "description": "Text alignment. Absent, or an unknown value, reads as the start of the line."
        },
        "content": {
          "type": "array",
          "maxLength": 200,
          "items": {
            "type": "union",
            "refs": ["#textRun", "#linkRun"]
          },
          "description": "The block's text, as runs in reading order."
        }
      }
    },
    "heading": {
      "type": "object",
      "required": ["level", "content"],
      "description": "A heading.",
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "align": {
          "type": "string",
          "maxLength": 16,
          "knownValues": ["center", "right"],
          "description": "Text alignment. Absent, or an unknown value, reads as the start of the line."
        },
        "content": {
          "type": "array",
          "maxLength": 200,
          "items": {
            "type": "union",
            "refs": ["#textRun", "#linkRun"]
          },
          "description": "The block's text, as runs in reading order."
        }
      }
    },
    "listItem": {
      "type": "object",
      "required": ["style", "content"],
      "description": "One list item; consecutive items of one style form a list.",
      "properties": {
        "style": {
          "type": "string",
          "maxLength": 16,
          "knownValues": ["bullet", "numbered", "check"],
          "description": "An unknown value renders as bullet."
        },
        "indent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "description": "Nesting depth, from 0."
        },
        "checked": {
          "type": "boolean",
          "description": "For check items: ticked."
        },
        "align": {
          "type": "string",
          "maxLength": 16,
          "knownValues": ["center", "right"],
          "description": "Text alignment. Absent, or an unknown value, reads as the start of the line."
        },
        "content": {
          "type": "array",
          "maxLength": 200,
          "items": {
            "type": "union",
            "refs": ["#textRun", "#linkRun"]
          },
          "description": "The block's text, as runs in reading order."
        }
      }
    },
    "quote": {
      "type": "object",
      "required": ["content"],
      "description": "A quote.",
      "properties": {
        "content": {
          "type": "array",
          "maxLength": 200,
          "items": {
            "type": "union",
            "refs": ["#textRun", "#linkRun"]
          },
          "description": "The block's text, as runs in reading order."
        }
      }
    },
    "codeBlock": {
      "type": "object",
      "required": ["text"],
      "description": "Preformatted code, shown as written.",
      "properties": {
        "text": {
          "type": "string",
          "maxGraphemes": 10000,
          "maxLength": 100000
        },
        "language": {
          "type": "string",
          "maxLength": 32,
          "description": "Language name, for display only."
        }
      }
    },
    "columns": {
      "type": "object",
      "required": ["columns"],
      "description": "Two or three columns side by side; they stack on narrow screens.",
      "properties": {
        "columns": {
          "type": "array",
          "minLength": 2,
          "maxLength": 3,
          "items": {
            "type": "ref",
            "ref": "#column"
          }
        }
      }
    },
    "column": {
      "type": "object",
      "required": ["blocks"],
      "description": "One column: blocks in reading order, no nested columns.",
      "properties": {
        "blocks": {
          "type": "array",
          "maxLength": 100,
          "items": {
            "type": "union",
            "refs": ["#display", "#paragraph", "#heading", "#listItem", "#quote", "#codeBlock"]
          }
        }
      }
    },
    "link": {
      "type": "object",
      "required": ["uri"],
      "description": "One link elsewhere.",
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri",
          "maxLength": 2000,
          "description": "An http or https URL."
        }
      }
    },
    "availability": {
      "type": "object",
      "description": "What the member is open to, such as work or collaborations.",
      "properties": {
        "label": {
          "type": "string",
          "maxGraphemes": 140,
          "maxLength": 1400,
          "description": "Short status line."
        },
        "detail": {
          "type": "string",
          "maxGraphemes": 300,
          "maxLength": 3000,
          "description": "Longer explanation."
        }
      }
    },
    "stat": {
      "type": "object",
      "required": ["label", "value"],
      "description": "One label and value pair.",
      "properties": {
        "label": {
          "type": "string",
          "maxGraphemes": 40,
          "maxLength": 400,
          "description": "What the number or word describes."
        },
        "value": {
          "type": "string",
          "maxGraphemes": 40,
          "maxLength": 400,
          "description": "The number or word."
        }
      }
    },
    "cta": {
      "type": "object",
      "description": "A call to action box with one link button.",
      "properties": {
        "title": {
          "type": "string",
          "maxGraphemes": 120,
          "maxLength": 1200,
          "description": "Box heading."
        },
        "body": {
          "type": "string",
          "maxGraphemes": 400,
          "maxLength": 4000,
          "description": "Box text."
        },
        "label": {
          "type": "string",
          "maxGraphemes": 80,
          "maxLength": 800,
          "description": "Button text."
        },
        "href": {
          "type": "string",
          "format": "uri",
          "maxLength": 2000,
          "description": "Button link: an http or https URL."
        }
      }
    }
  }
}
