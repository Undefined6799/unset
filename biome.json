{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!docs/ai/PLAN.md", "!LICENSE"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "linter": {
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": "warn",
        "noImportantStyles": "error"
      },
      "correctness": { "noMissingVarFunction": "error" },
      "nursery": { "useLayeredStyles": "error" },
      "style": {
        "noHexColors": "error",
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "useConst": "error"
      },
      "suspicious": {
        "noConsole": "error",
        "noEmptyBlockStatements": "error",
        "noExplicitAny": "error",
        "noFocusedTests": "error",
        "noSkippedTests": "error"
      }
    }
  },
  "javascript": { "formatter": { "quoteStyle": "double", "trailingCommas": "all" } },
  "css": { "linter": { "enabled": true }, "formatter": { "enabled": true } },
  "overrides": [
    {
      "includes": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": { "level": "warn", "options": { "maxLines": 300, "skipBlankLines": true } }
          }
        }
      }
    },
    {
      "includes": ["**/*.generated.*"],
      "linter": { "rules": { "style": { "noExcessiveLinesPerFile": "off" } } }
    },
    {
      "includes": ["**/*.css", "!shared/ui/src/tokens.css"],
      "plugins": ["./scripts/lint/biome/token-only.grit"]
    },
    {
      "includes": [
        "apps/**/*.tsx",
        "apps/**/*.jsx",
        "interfaces/**/*.tsx",
        "interfaces/**/*.jsx",
        "shared/**/*.tsx",
        "shared/**/*.jsx"
      ],
      "plugins": ["./scripts/lint/biome/no-style-prop.grit"]
    },
    {
      "includes": ["shared/ui/src/tokens.css"],
      "linter": { "rules": { "style": { "noHexColors": "off" } } }
    },
    {
      "includes": ["scripts/**"],
      "linter": { "rules": { "suspicious": { "noConsole": "off" } } }
    }
  ]
}
