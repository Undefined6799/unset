# A template for the development stack's interpolation file (P1.29). Every value here is a placeholder. Copy it to
# ../unset-dev-env/dev-public.env (unset-dev-env is a folder beside this checkout owned by you, mode 0700, with the file
# at 0600), then set the real values there. No live env file lives in the checkout: postgres builds from the repository
# root, and C26 refuses a build context that holds one (architecture record
# 2026-10-12-p127u-bind-ancestors-and-build-context, Amendments 2 and 3). `npm run dev:up` passes that file as
# --interpolation-env to the preflight and as --env-file to Compose; nothing else reads it, and no service gets it
# whole. Secrets never go here: they are files in ../unset-dev-secrets/ (docs/human/runbooks/dev-stack-secrets.md).

# The web server's own origins (interfaces/http/config.ts): the media origin is another site than the public one, and
# both use a TLD in shared/http/config.ts KNOWN_TLDS, so a local stack uses .test names, not .localhost.
WEB_PUBLIC_ORIGIN=https://app.example.test
WEB_ALLOWED_HOSTS=app.example.test
WEB_MEDIA_ORIGIN=https://media.example.net
# The app's host, the one in WEB_PUBLIC_ORIGIN. The edge answers for it on the PDS's network, so the PDS fetches the
# app's client metadata through the edge (P1.29a).
APP_HOST=app.example.test

# The PDS's public host, read by the PDS and the edge (P1.29a): staging.unset.ac on the homelab staging stack (ADR
# 0025), a name ending in .localhost on a local one (step book P1.29, "Inputs"). Handles are minted under
# PDS_SERVICE_HANDLE_DOMAINS, written out, never the default (.staging.unset.name on staging).
PDS_HOSTNAME=pds.unset.localhost
PDS_SERVICE_HANDLE_DOMAINS=.pds.unset.localhost
# The PDS's own DID, read by pds-admin (P2.09e) and, from P2.10, web: web signs it into every admin envelope and
# pds-admin refuses an envelope naming another, so an envelope for one stack never works on another. The PDS's service
# DID is did:web of its host (@atproto/pds 0.5.51 dist/config/config.js:14): did:web:staging.unset.ac on staging.
PDS_DID=did:web:pds.unset.localhost
# The PDS's public origin, read by the indexer (P3.05s): a DID is ours when its document names exactly this origin.
# https://staging.unset.ac on staging.
PDS_PUBLIC_URL=https://pds.unset.localhost
# The address Caddy gives the ACME CA for the PDS host's certificate.
EDGE_ACME_EMAIL=edge@example.test

# The kid of the client key new sign-ins sign with (P2.04w): one of the keys in unset-dev-secrets/web_oauth_client_keys.
# A rotation adds a key, then changes this (docs/human/runbooks/oauth-key-rotation.md).
WEB_OAUTH_ACTIVE_KID=web-2026-10

# The kid of web's key for pds-admin (P2.10): the kid of the one entry in unset-dev-secrets/pds_admin_keys, whose
# private half is unset-dev-secrets/web_pds_admin_key (docs/human/runbooks/dev-stack-secrets.md "The web key pair").
WEB_PDS_ADMIN_KID=web-2026-11

# The owner's DID (P2.10s): when a visitor's invite request cannot be mailed, this member's notifications say so, once a
# day, naming no visitor. Read by web on the staging stacks only, where invite requests are on.
INVITE_REQUEST_OWNER_DID=did:plc:aaaaaaaaaaaaaaaaaaaaaaaa
