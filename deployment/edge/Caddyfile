# The edge (P1.28): terminates TLS for every public host, writes no client address, path or query to any log, denies
# the PDS admin surface, limits clients in memory only, and never passes the client address upstream (plan §5.2,
# §5.7, §6; invariant 3). Read against Caddy v2.11.7 (caddyserver/website src/docs/markdown/caddyfile/options.md).
{
	# No admin API and no saved config: the image is read-only and nothing changes at run time.
	admin off
	persist_config off
	# The default (non-access) log (Caddy v2.11.7 options.md "log"): ERROR and above, on stderr, with every address
	# field deleted. Go's http.Server writes "TLS handshake error from <ip>:<port>" and "http: panic serving
	# <ip>:<port>" as the message, which a filter cannot touch (`msg` is not filterable, log.md "filter"); Caddy v2.11.7
	# sends both through the http.stdlib logger (modules/caddyhttp/app.go:482 and 695-713: handshake errors at DEBUG,
	# panics at ERROR), so that logger is excluded.
	log default {
		output stderr
		level ERROR
		exclude http.log.access http.stdlib
		format filter {
			wrap json
			fields {
				remote_ip delete
				data>remote_ip delete
				remote_addr delete
				remote delete
				client_ip delete
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers delete
				request>uri delete
				request>tls delete
				resp_headers delete
			}
		}
	}
	# The dev edge's one listener (P1.36j; ADR 0030 Decision 2): its sites bind the newt_edge address, and Newt, at its
	# fixed address on that internal network, is the only peer whose X-Forwarded-For is read, right to left, so the
	# address Pangolin appended is the client's and anything a client wrote before it is ignored. A `servers` block with
	# a listener applies only to the server bound to exactly that address and port (caddyserver/website 1957519
	# src/docs/markdown/caddyfile/options.md:836-880, "trusted_proxies" and "trusted_proxies_strict" at 1090-1140), so
	# prod and local, which bind nothing there, keep no trusted proxy. Caddy v2.11.7 sorts these blocks longest
	# listener first and applies the first that matches a server (caddyconfig/httpcaddyfile/httptype.go:453-466,
	# serveroptions.go:427-437), so this block wins over the shared one wherever it applies. The zones key on {client_ip}, which is the
	# socket address for every request not from a trusted proxy (options.md:1094).
	servers 10.250.37.3:443 {
		trusted_proxies static 10.250.37.2/32
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
		timeouts {
			read_body 30s
			write 135s
			idle 2m
		}
	}
	servers {
		# No trusted_proxies: nothing else sits in front of the edge.
		# Above the upstream's 130 s (snippets/upstream.caddy, limits.json).
		timeouts {
			read_body 30s
			write 135s
			idle 2m
		}
	}
}

import snippets/*.caddy

# The image's own health check (HEALTHCHECK in the Dockerfile): loopback only, never routed from outside, not logged.
http://127.0.0.1:8081 {
	bind 127.0.0.1
	respond /health 200
	respond 404
}

# One file per enabled public host; each environment mounts its own set (P1.29 dev, P5 production).
import sites/enabled/*.caddy
