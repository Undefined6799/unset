# The docs site on the dev stack (P1.21w; ADR 0075): the built Hugo output of docs/site, served as files by the edge
# itself, with no upstream. Pangolin reaches it through Newt like the other two dev sites (ADR 0030 Decision 2,
# ADR 0032 Decision 5), so it binds the newt_edge address only, serves the dev leaf, and is never indexed. One
# read-only file bind at /etc/caddy/sites/enabled/docs.caddy; the files are one read-only folder bind at /srv/docs
# (compose.dev.yaml). Read against Caddy v2.11.9 modules/caddyhttp/fileserver/staticfiles.go: the path is joined under
# the root with caddyhttp.SanitizedPathJoin (:303), so no request names a file outside it, and any method but GET and
# HEAD gets 405 (:534-540).
#
# The CSP is the theme's needs and no more (Hextra v0.13.0 as built at P1.21w): every script and stylesheet is a file
# on this origin, the search index is fetched from it, and one data: image sits in the compiled CSS. No inline
# script, no inline style (docs/site/assets/css/custom.css carries the one style attribute that mattered), no eval.
{$DOCS_HOST} {
	bind 10.250.37.3
	import tls
	import access-log
	import security-headers
	header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
	import too-many-tries
	import noindex
	route {
		# One zone, every request, keyed on the client (limits.json docsRateLimitZones; limits.budget.test.ts). A page
		# with no cache is at most twelve requests: the page, the stylesheet, five scripts, the icons, the manifest and
		# the search index.
		rate_limit {
			zone docs_global {
				key {client_ip}
				ipv6_prefix 64
				events 6000
				window 5m
			}
			disable_metrics
		}
		file_server {
			root /srv/docs
		}
	}
}
