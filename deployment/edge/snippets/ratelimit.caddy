# Per-client limits at the edge (P1.28; ADR 0018). github.com/mholt/caddy-ratelimit, sliding window, in memory only:
# no `distributed` block and no `storage`, so no client address is written to disk or shared; `disable_metrics`, so no
# address becomes a metrics label; no `log_key`. Zones are keyed by the client address ({client_ip}): the socket
# address, except on the dev listener, where it comes from Newt's X-Forwarded-For (the Caddyfile, P1.36j). An IPv6 client is keyed by its /64, so rotating addresses inside one subnet neither escapes a limit
# nor allocates a ring per address (each key holds `events` timestamps, ringbuffer.go:46). The numbers are
# architecture's starting values (record 2026-10-07-p1b-a1-pds-no-forwarded-address, "Zone values for P1.28", 01:52Z),
# the same as limits.json rateLimitZones (edge_ratelimit_matches_limits). They take over the PDS's own per-address
# limits, which are off because the PDS sees only the edge's address (P1b-A1, "Do not forward"). A request counts in
# every zone it matches; paired limits (session, firehose) are two zones on one matcher; global has no matcher, so
# every PDS route has a zone, except web's own calls (below). OAuth paths are @atproto/oauth-provider's (create-oauth-middleware.ts,
# create-api-middleware.ts and oauth-provider-api constants.ts at atproto 2902aa2). Over a limit: 429 with
# Retry-After. The app's own limits stay the inner layer; these replace nothing.
#
# Web's own calls (P1.21j; Proposed ADR 0071). Web reaches our PDS through Pangolin like any client, so every member's
# calls share web's one address, and global and oauth_token would cap the whole site. Web marks each call it makes to
# our PDS with X-Unset-Web-Key: "key-", the 64 hex characters of the pds_web_key secret, "-key". A request is marked
# only when the header is that exact value: lower-case hex between the fixed ends, and equal to the ends around the
# secret file the edge reads at request time (Caddy v2.11.9 replacer.go fileReplacementProvider; matchers.go
# matchHeaders compares exactly unless the expected value starts or ends with "*", which the fixed ends rule out). A
# missing file reads as empty, so the expected value is "key--key", which the hex pattern can never be: a missing or
# wrong secret leaves web in the tight zones, as before. A marked request skips global and oauth_token and counts in
# web_global and web_oauth_token, one bucket keyed `web`, so a leaked key does not multiply by address. The header is
# compared, never logged (log.caddy deletes request headers), and never reaches the PDS (upstream.caddy).
(pds-ratelimit) {
	rate_limit {
		zone session {
			match {
				path /xrpc/com.atproto.server.createSession
			}
			key {client_ip}
			ipv6_prefix 64
			events 30
			window 5m
		}
		zone session_day {
			match {
				path /xrpc/com.atproto.server.createSession
			}
			key {client_ip}
			ipv6_prefix 64
			events 300
			window 24h
		}
		zone oauth_signin {
			match {
				method POST
				path /@atproto/oauth-provider/~api/sign-in
			}
			key {client_ip}
			ipv6_prefix 64
			events 30
			window 5m
		}
		zone oauth_token {
			match {
				path /oauth/token /xrpc/com.atproto.server.refreshSession
				not {
					header_regexp X-Unset-Web-Key ^key-[0-9a-f]+-key$
					header X-Unset-Web-Key key-{file./run/secrets/pds_web_key}-key
				}
			}
			key {client_ip}
			ipv6_prefix 64
			events 120
			window 5m
		}
		zone signup {
			match {
				path /xrpc/com.atproto.server.createAccount /@atproto/oauth-provider/~api/sign-up
			}
			key {client_ip}
			ipv6_prefix 64
			events 10
			window 1h
		}
		zone reset {
			match {
				path /xrpc/com.atproto.server.requestPasswordReset /xrpc/com.atproto.server.resetPassword /xrpc/com.atproto.server.requestEmailConfirmation /xrpc/com.atproto.server.requestEmailUpdate /@atproto/oauth-provider/~api/reset-password-request /@atproto/oauth-provider/~api/reset-password-confirm /@atproto/oauth-provider/~api/update-email-request /@atproto/oauth-provider/~api/verify-email-request
			}
			key {client_ip}
			ipv6_prefix 64
			events 5
			window 1h
		}
		zone sync {
			match {
				path /xrpc/com.atproto.sync.*
				not path /xrpc/com.atproto.sync.getBlob
				not path /xrpc/com.atproto.sync.subscribeRepos
			}
			key {client_ip}
			ipv6_prefix 64
			events 1500
			window 5m
		}
		zone blob_read {
			match {
				path /xrpc/com.atproto.sync.getBlob
			}
			key {client_ip}
			ipv6_prefix 64
			events 600
			window 5m
		}
		zone blob_upload {
			match {
				path /xrpc/com.atproto.repo.uploadBlob
			}
			key {client_ip}
			ipv6_prefix 64
			events 60
			window 5m
		}
		zone firehose {
			match {
				path /xrpc/com.atproto.sync.subscribeRepos
			}
			key {client_ip}
			ipv6_prefix 64
			events 6
			window 1m
		}
		zone firehose_hour {
			match {
				path /xrpc/com.atproto.sync.subscribeRepos
			}
			key {client_ip}
			ipv6_prefix 64
			events 60
			window 1h
		}
		zone identity {
			match {
				path /xrpc/com.atproto.identity.* /xrpc/com.atproto.server.describeServer /.well-known/atproto-did /xrpc/_health
			}
			key {client_ip}
			ipv6_prefix 64
			events 300
			window 5m
		}
		zone global {
			match {
				not {
					header_regexp X-Unset-Web-Key ^key-[0-9a-f]+-key$
					header X-Unset-Web-Key key-{file./run/secrets/pds_web_key}-key
				}
			}
			key {client_ip}
			ipv6_prefix 64
			events 3000
			window 5m
		}
		# Web's own calls (P1.21j; Proposed ADR 0071): marked with the key only web holds, they leave global and
		# oauth_token above for these two, one bucket for all of web whatever address it arrives from (`key web`). A
		# marked zone for uploads would sit here in the same shape (ADR 0070 owns blob_upload).
		zone web_global {
			match {
				header_regexp X-Unset-Web-Key ^key-[0-9a-f]+-key$
				header X-Unset-Web-Key key-{file./run/secrets/pds_web_key}-key
			}
			key web
			events 90000
			window 1m
		}
		zone web_oauth_token {
			match {
				path /oauth/token /xrpc/com.atproto.server.refreshSession
				header_regexp X-Unset-Web-Key ^key-[0-9a-f]+-key$
				header X-Unset-Web-Key key-{file./run/secrets/pds_web_key}-key
			}
			key web
			events 3000
			window 5m
		}
		disable_metrics
	}
}

# The dev app site's own zones (P1.36b; ADR 0031 Decision 1, architecture 2026-10-20 13:18Z): new names, so no state is
# shared with the PDS site's zones (one pool per zone name, as above), and the dev app site imports these alone, never
# pds-ratelimit. app_signin holds one client below web's shared sign-in bucket, app_burst caps one client's burst, and
# app_global, with no matcher, keeps every app route in a zone and holds one client's average under 4 a second.
# Values as limits.json appRateLimitZones (edge_app_zones_match_limits).
# app_global's size (ADR 0031 Decision 1, "measured page load plus headroom"), recounted in Chromium on the SvelteKit
# build at P1.20j: a page with a cold cache was 5 requests to the app name on an app page (the HTML, the one script and
# one stylesheet of output.bundleStrategy "single", and the 2 fonts) and 4 on a public page (no script). The build's
# files are hashed and cached a year, the fonts a day, so a warm page is 1. A first visit from / through sign-in, the
# three welcome steps and /me is 6 pages, 4 POSTs and the callback: 29 requests warm as counted at P1.36b, 33 with no
# cache at all. Under "split" (P1.21g) the one script becomes the 34 pieces those pages import, so the uncached visit
# is about 66: 1200 is about 18 of them per address per 5 minutes, still room for a few testers behind one address,
# and a warm page is still 1. app_burst was 20 per 10s until P1.20r (Alex
# 2026-11-19 13:17:24Z, "increase it from 20 to 60"): a member pressing Settings and Profile about twice a second met
# it, and a warm client navigation costs one request (its __data.json). At 60 per 10s it lets a member click four
# times a second for ten seconds after a cold page and still refuses a flood; it allows 1800 per 5 minutes, so
# app_global (1200) now binds a client that keeps that pace for minutes. Behind the edge, web's own default bucket is
# site-wide (3000 at once, 50 a second; ADR 0042), so about thirteen addresses at app_global's average drain it, where
# twenty-five at the old 2 a second did; fifty addresses sending their 60 at once empty it, where 150 did (ADR 0066).
# app_signin counts POST /join too (P2.10): it starts a sign-up at our PDS, as POST /login starts a sign-in. Since
# P1.21j (Proposed ADR 0071) it counts only those two, 10 per 5 minutes: the callback can only follow a login the zone
# already counted, and POST /verify-email needs a signed-in session, so counting them made one first sign-in three
# events and two people behind one address went over. Both still count in app_burst and app_global.
# app_files (P1.21g; ADR 0069): the split client (output.bundleStrategy "split") loads a cold app page as about 30
# content-hashed build files under /_app/immutable/, in a second, so they count in app_files instead of app_burst;
# documents, data, fonts, version.json and every POST stay in app_burst as before, and app_global still counts
# everything, files too. A request is a build file only when it is a GET or HEAD and its decoded path, before Caddy
# cleans it, is one of the names SvelteKit 3.2.0 writes (entry/, nodes/, chunks/, assets/; one hash of [A-Za-z0-9_-],
# a known extension): {http.request.uri.path} is the request's own decoded path (Caddy v2.11.9 replacer.go:186), so
# no run of slashes, dot segment, letter case or other spelling that web would read as another route can match.
# adapter-node serves the files from a table built at boot, with a year's immutable caching, and SvelteKit answers a
# missing one under /_app/ with a plain 404 before any hook runs (kit 3.2.0 src/runtime/server/respond.js:367), so
# nothing this zone counts reaches a hook, a session or the database. 120 per 10 s is four cold pages of 30 at once.
(app-build-file) {
	method GET HEAD
	vars_regexp {http.request.uri.path} ^/_app/immutable/(?:entry|nodes|chunks|assets)/[\w-]+(?:\.[\w-]+)?\.(?:js|css|woff2|png)$
}

(app-ratelimit) {
	rate_limit {
		zone app_signin {
			match {
				method POST
				path /login /join
			}
			key {client_ip}
			ipv6_prefix 64
			events 10
			window 5m
		}
		zone app_burst {
			match {
				not {
					import app-build-file
				}
			}
			key {client_ip}
			ipv6_prefix 64
			events 60
			window 10s
		}
		zone app_files {
			match {
				import app-build-file
			}
			key {client_ip}
			ipv6_prefix 64
			events 120
			window 10s
		}
		zone app_global {
			key {client_ip}
			ipv6_prefix 64
			events 1200
			window 5m
		}
		disable_metrics
	}
}

# The dev chat site's zones (P6.02; dev/chat.caddy): new names, so no state is shared with another site. chat_signin
# counts the two requests of each sign-in hop, GET /sign-in and POST /sign-in/redeem, and each sign-out hop's ticket,
# POST /sign-out/redeem (#1950; ADR 0083 decision 5); chat_global, with no matcher, counts everything, the page, its
# files and the Matrix client API alike. Behind the edge the door and Synapse see only the edge's address, so these are the per-client limits. Values as limits.json chatRateLimitZones
# (edge_ratelimit_matches_limits; limits.budget.test.ts says why they fit).
(chat-ratelimit) {
	rate_limit {
		zone chat_signin {
			match {
				path /sign-in /sign-in/redeem /sign-out/redeem
			}
			key {client_ip}
			ipv6_prefix 64
			events 20
			window 5m
		}
		zone chat_global {
			key {client_ip}
			ipv6_prefix 64
			events 6000
			window 5m
		}
		disable_metrics
	}
}
