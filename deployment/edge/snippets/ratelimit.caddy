# Per-client limits at the edge (P1.28; ADR 0018). github.com/mholt/caddy-ratelimit, sliding window, in memory only:
# no `distributed` block and no `storage`, so no client address is written to disk or shared; `disable_metrics`, so no
# address becomes a metrics label; no `log_key`. Zones are keyed by the client address ({client_ip}): the socket
# address, except on the dev listener, where it comes from Newt's X-Forwarded-For (the Caddyfile, P1.36j). An IPv6 client is keyed by its /64, so rotating addresses inside one subnet neither escapes a limit
# nor allocates a ring per address (each key holds `events` timestamps, ringbuffer.go:46). The numbers are
# architecture's starting values (record 2026-10-07-p1b-a1-pds-no-forwarded-address, "Zone values for P1.28", 01:52Z),
# the same as limits.json rateLimitZones (edge_ratelimit_matches_limits). They take over the PDS's own per-address
# limits, which are off because the PDS sees only the edge's address (P1b-A1, "Do not forward"). A request counts in
# every zone it matches; paired limits (session, firehose) are two zones on one matcher; global has no matcher, so
# every PDS route has a zone. OAuth paths are @atproto/oauth-provider's (create-oauth-middleware.ts,
# create-api-middleware.ts and oauth-provider-api constants.ts at atproto 2902aa2). Over a limit: 429 with
# Retry-After. The app's own limits stay the inner layer; these replace nothing.
(pds-ratelimit) {
	rate_limit {
		zone session {
			match {
				path /xrpc/com.atproto.server.createSession
			}
			key {client_ip}
			ipv6_prefix 64
			events 30
			window 5m
		}
		zone session_day {
			match {
				path /xrpc/com.atproto.server.createSession
			}
			key {client_ip}
			ipv6_prefix 64
			events 300
			window 24h
		}
		zone oauth_signin {
			match {
				method POST
				path /@atproto/oauth-provider/~api/sign-in
			}
			key {client_ip}
			ipv6_prefix 64
			events 30
			window 5m
		}
		zone oauth_token {
			match {
				path /oauth/token /xrpc/com.atproto.server.refreshSession
			}
			key {client_ip}
			ipv6_prefix 64
			events 120
			window 5m
		}
		zone signup {
			match {
				path /xrpc/com.atproto.server.createAccount /@atproto/oauth-provider/~api/sign-up
			}
			key {client_ip}
			ipv6_prefix 64
			events 10
			window 1h
		}
		zone reset {
			match {
				path /xrpc/com.atproto.server.requestPasswordReset /xrpc/com.atproto.server.resetPassword /xrpc/com.atproto.server.requestEmailConfirmation /xrpc/com.atproto.server.requestEmailUpdate /@atproto/oauth-provider/~api/reset-password-request /@atproto/oauth-provider/~api/reset-password-confirm /@atproto/oauth-provider/~api/update-email-request /@atproto/oauth-provider/~api/verify-email-request
			}
			key {client_ip}
			ipv6_prefix 64
			events 5
			window 1h
		}
		zone sync {
			match {
				path /xrpc/com.atproto.sync.*
				not path /xrpc/com.atproto.sync.getBlob
				not path /xrpc/com.atproto.sync.subscribeRepos
			}
			key {client_ip}
			ipv6_prefix 64
			events 1500
			window 5m
		}
		zone blob_read {
			match {
				path /xrpc/com.atproto.sync.getBlob
			}
			key {client_ip}
			ipv6_prefix 64
			events 600
			window 5m
		}
		zone blob_upload {
			match {
				path /xrpc/com.atproto.repo.uploadBlob
			}
			key {client_ip}
			ipv6_prefix 64
			events 60
			window 5m
		}
		zone firehose {
			match {
				path /xrpc/com.atproto.sync.subscribeRepos
			}
			key {client_ip}
			ipv6_prefix 64
			events 6
			window 1m
		}
		zone firehose_hour {
			match {
				path /xrpc/com.atproto.sync.subscribeRepos
			}
			key {client_ip}
			ipv6_prefix 64
			events 60
			window 1h
		}
		zone identity {
			match {
				path /xrpc/com.atproto.identity.* /xrpc/com.atproto.server.describeServer /.well-known/atproto-did /xrpc/_health
			}
			key {client_ip}
			ipv6_prefix 64
			events 300
			window 5m
		}
		zone global {
			key {client_ip}
			ipv6_prefix 64
			events 3000
			window 5m
		}
		disable_metrics
	}
}

# The dev app site's own zones (P1.36b; ADR 0031 Decision 1, architecture 2026-10-20 13:18Z): new names, so no state is
# shared with the PDS site's zones (one pool per zone name, as above), and the dev app site imports these alone, never
# pds-ratelimit. app_signin holds one client below web's shared sign-in bucket, app_burst caps one client's burst, and
# app_global, with no matcher, keeps every app route in a zone and holds one client's average under 4 a second. Values as limits.json appRateLimitZones (edge_app_zones_match_limits).
# app_global's size (ADR 0031 Decision 1, "measured page load plus headroom"), recounted in Chromium on the SvelteKit
# build at P1.20j: a page with a cold cache is 5 requests to the app name on an app page (the HTML, the one script and
# one stylesheet of output.bundleStrategy "single", interfaces/web/vite.config.ts, and the 2 fonts) and 4 on a public
# page (no script). The build's files are hashed and cached a year, the fonts a day, and every page shares them, so a
# warm page is 1. A first visit from / through sign-in, the three welcome steps and /me is 6 pages, 4 POSTs and the
# callback: 29 requests warm as counted at P1.36b, 33 with no cache at all. 1200 is about 36 such uncached visits per
# address per 5 minutes: room for a few testers behind one address. app_burst was 20 per 10s until P1.20r (Alex
# 2026-11-19 13:17:24Z, "increase it from 20 to 60"): a member pressing Settings and Profile about twice a second met
# it, and a warm client navigation costs one request (its __data.json). At 60 per 10s it lets a member click four
# times a second for ten seconds after a cold page and still refuses a flood; it allows 1800 per 5 minutes, so
# app_global (1200) now binds a client that keeps that pace for minutes. Behind the edge, web's own default bucket is
# site-wide (3000 at once, 50 a second; ADR 0042), so about thirteen addresses at app_global's average drain it, where
# twenty-five at the old 2 a second did.
# app_signin counts POST /join too (P2.10): it starts a sign-up at our PDS, as POST /login starts a sign-in.
# app_signin's two match blocks are either-or: each is one matcher set, and a zone counts a request any set matches
# (caddy-ratelimit 5625512f24f6 caddyfile.go:141-147, handler.go:205); the callback arrives as a GET redirect.
(app-ratelimit) {
	rate_limit {
		zone app_signin {
			match {
				method POST
				path /login /verify-email /join
			}
			match {
				path /oauth/callback
			}
			key {client_ip}
			ipv6_prefix 64
			events 5
			window 5m
		}
		zone app_burst {
			key {client_ip}
			ipv6_prefix 64
			events 60
			window 10s
		}
		zone app_global {
			key {client_ip}
			ipv6_prefix 64
			events 1200
			window 5m
		}
		disable_metrics
	}
}
