# The access log's route class (P1.28; rule SE-7; R3-16): a closed set of names, never a capture of a user segment.
# First match wins; anything else is `other`. Caddy v2.11.7 map and log_append directives
# (caddyserver/website src/docs/markdown/caddyfile/directives/map.md, log_append.md).
(pds-route-class) {
	map {http.request.orig_uri} {route_class} {
		~^/xrpc/(_health|[A-Za-z][A-Za-z0-9-]*(?:\.[A-Za-z0-9-]+)+)(?:\?[^#]*)?$ "xrpc:${1}"
		~^/oauth/ oauth
		~^/\.well-known/ well-known
		~^/health(?:\?[^#]*)?$ health
		default other
	}
	log_append route_class {route_class}
}

# The app site's route class (staging, 2026-11-21: three bursts of 429s the access log could not explain, because it
# keeps no path). The same closed set of names as above, never a capture: a build file, the version check, a font, a
# page's data request, a form action, a picture upload, the health check, or `other` (a page itself). Imported on the
# dev app site only; it changes no limit.
(app-route-class) {
	map {http.request.orig_uri} {route_class} {
		~^/_app/immutable/ build
		~^/_app/version\.json(?:\?[^#]*)?$ version
		~^/fonts/ fonts
		~^[^?#]*/__data\.json(?:\?[^#]*)?$ data
		~^[^?#]*\?/ action
		~^/images(?:\?[^#]*)?$ images
		~^/health(?:\?[^#]*)?$ health
		default other
	}
	log_append route_class {route_class}
}
