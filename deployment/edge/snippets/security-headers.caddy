# Response headers every public host gets (P1.28). HSTS without preload until Alex decides. The app sets its own CSP
# (P1.08); a host without an app CSP imports strict-csp as well.
(security-headers) {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options nosniff
		?Referrer-Policy no-referrer
		-Server
		-Via
	}
}

(strict-csp) {
	header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
}

# Staging is never indexed (P1.36b; ADR 0031 Decision 1): every response of both dev sites says so. No robots.txt
# Disallow beside it, which would stop a crawler from ever fetching the header.
(noindex) {
	header X-Robots-Tag "noindex, nofollow"
}

# The strict policy for a response that sets none of its own (P6.02, the chat site): Caddy's `?` sets it only when the
# header is absent at write time, so an upstream's own policy stands (Caddy v2.11.9 caddyfile/directives/header.md,
# the `?` prefix; modules/caddyhttp/headers/caddyfile.go).
(strict-csp-default) {
	header ?Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
}
