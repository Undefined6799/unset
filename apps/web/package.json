{
  "name": "@unset/apps-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "main": "render.tsx",
  "exports": {
    ".": "./render.tsx",
    "./server": {
      "types": "./render.tsx",
      "default": "./dist/server/render.js"
    },
    "./app.css": "./app.css",
    "./theme.css": "./theme.css",
    "./lib/utils": "./lib/utils.ts",
    "./lib/components/icon": "./lib/components/icon/index.ts",
    "./lib/components/ui/*": "./lib/components/ui/*/index.ts",
    "./lib/components/profile/*": "./lib/components/profile/*",
    "./lib/profile/*": "./lib/profile/*",
    "./lib/fonts/*.woff2": "./lib/fonts/*.woff2",
    "./lib/icons/*.png": "./lib/icons/*.png"
  },
  "scripts": {
    "build": "vite build --config vite.config.ts && vite build --config vite.config.ts --ssr render.tsx",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.svelte.json --fail-on-warnings"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@unset/shared-errors": "*",
    "@unset/shared-islands": "*",
    "@unset/shared-safe-href": "*",
    "@unset/shared-ui": "*",
    "bits-ui": "2.20.6",
    "cn": "0.3.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "svelte": "5.57.3",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3"
  }
}
